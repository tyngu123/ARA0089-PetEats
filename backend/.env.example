# Porta da API (no Render ela é definida automaticamente)
PORT=3000

# Opção 1 – MySQL local
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=coloque_a_senha_local_aqui
DB_NAME=peteats

# Opção 2 – MySQL na nuvem (Aiven): use a "Service URI" do painel do Aiven
# DATABASE_URL=mysql://avnadmin:SENHA@HOST.aivencloud.com:PORTA/defaultdb?ssl-mode=REQUIRED
# DB_NAME=peteats
# DB_SSL=true
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Cria as contas de demonstração (senha 123456). Use false para desativar.
SEED_DEMO=true
